# Larder 环境变量样例。复制为 .env 后按需修改（.env 已被 git 忽略）。
# 环境变量优先级最高，会覆盖 larder.toml 中的同名配置。

# ---- 服务 ----
LARDER_ADDR=127.0.0.1:8765
# 多知识库根目录：每个库为其中的 <id>.db。相对路径相对于 exe 所在目录。
LARDER_DATA_DIR=data
LARDER_LOG_LEVEL=info
LARDER_LOG_FORMAT=text
# 是否提供 MCP 端点
LARDER_MCP_ENABLED=true

# ---- 向量模型（OpenAI 兼容 /v1/embeddings） ----
LARDER_EMBED_BASE_URL=https://api.siliconflow.cn
LARDER_EMBED_API_KEY=sk-xxx
LARDER_EMBED_MODEL=BAAI/bge-m3
# 提示值；实际维度以服务返回为准
LARDER_EMBED_DIM=1024

# ---- 解析器（plain 无需配置；mineru/docling/tika 需要） ----
# plain：本地解析 Markdown/文本/代码/文字版 PDF/DOCX/PPTX/XLSX/EPUB/HTML。
# mineru/docling/tika：本地优先，扫描件/矢量 PDF 自动走外部 API 做 OCR。
# 官方云 API（mineru.net）示例：
#   LARDER_PARSE_PROVIDER=mineru
#   LARDER_PARSE_BASE_URL=https://mineru.net
#   LARDER_PARSE_API_KEY=<在 https://mineru.net 的 API 管理页面创建的 Token>
#   LARDER_PARSE_MODEL=pipeline
# 自建 MinerU（本地部署 /file_parse）：
#   LARDER_PARSE_BASE_URL=http://127.0.0.1:8888
#   LARDER_PARSE_PATH=/file_parse
LARDER_PARSE_PROVIDER=plain
LARDER_PARSE_BASE_URL=
LARDER_PARSE_API_KEY=
LARDER_PARSE_MODEL=
LARDER_PARSE_PATH=

# ---- 重排（可选） ----
LARDER_RERANK_ENABLED=false
LARDER_RERANK_BASE_URL=https://api.siliconflow.cn
LARDER_RERANK_API_KEY=
LARDER_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LARDER_RERANK_PATH=/v1/rerank

